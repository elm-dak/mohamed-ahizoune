---
import '../styles/global.css';
import '../styles/refinement.css';
import '../styles/visual-details.css';
import ProgramExplorer from '../components/ProgramExplorer.astro';
import Pricing from '../components/Pricing.astro';
import ContactForm from '../components/ContactForm.astro';
import Skills from '../components/Skills.astro';
import SvgMark from '../components/SvgMark.astro';
import FloatingEnquiry from '../components/FloatingEnquiry.astro';
import { instagram } from '../data/site';
const faqs = [
  ['Where do I start?', 'Fill in the contact form with your goal and training experience. Review your enquiry, then use the available contact option to send it to Mohamed.'],
  ['Do I need to be an experienced athlete?', 'Your starting point is part of the conversation. Whether you’re building your first routine or refining an established one, share your experience so Mohamed can discuss what’s appropriate for you.'],
  ['How can I learn about coaching options?', 'Compare the Starter, Transformation, and Elite packs above. Choose a pack to add it to your enquiry, then contact Mohamed to discuss availability and how the coaching works.'],
  ['Where can I follow Mohamed’s journey?', 'Follow @_mohamed_ahizoune on Instagram for his latest training content and updates. You can open his profile from any Instagram link on this page.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11120f" />
    <script is:inline>
      try { const saved = localStorage.getItem('ma-theme'); document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark'; } catch { document.documentElement.dataset.theme = 'dark'; }
    </script>
    <title>Mohamed Ahizoune | Built with purpose.</title>
    <meta name="description" content="Meet Mohamed Ahizoune. Explore a focused approach to physique, strength, and personal progress. Connect on Instagram to discuss your goals." />
    <meta property="og:title" content="Mohamed Ahizoune | Built with purpose." />
    <meta property="og:description" content="The physique is the result. The discipline is the story. Discover Mohamed Ahizoune." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/mohamed-stage.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="#home" aria-label="Mohamed Ahizoune, home"><span class="brand-symbol">M<span>A</span><i></i></span><span class="brand-name">MOHAMED<br />AHIZOUNE<span class="brand-dot">.</span></span></a>
      <nav aria-label="Main navigation" id="navigation"><a href="#about">The athlete</a><a href="#programs">Programs</a><a href="#pricing">Coaching</a><a href="#achievements">Achievements</a></nav>
      <div class="header-actions"><button type="button" class="theme-toggle" aria-label="Switch to light mode" title="Switch to light mode"><svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg><svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.1A8.8 8.8 0 0 1 9.9 3.5 8.8 8.8 0 1 0 20.5 14.1Z" /></svg></button><a class="nav-cta" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label="Open navigation"><span></span><span></span></button></div>
    </header>
    <main id="main">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">MOHAMED AHIZOUNE / PERSONAL COACHING</p>
            <h1 id="hero-title">BUILT<br />WITH<br /><span class="accent">PURPOSE<span class="title-period">.</span></span></h1>
            <p class="hero-description">Six years of experience.<br />Training built around your goals.<br /><span>Your next chapter starts here.</span></p>
            <a class="button button-lime" href="#programs">Explore the programs <span aria-hidden="true">↗</span></a>
            <a class="hero-secondary" href={instagram} target="_blank" rel="noopener noreferrer">Meet Mohamed on Instagram <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-visual">
            <div class="photo-frame"><img src="/images/mohamed-stage.webp" alt="Mohamed Ahizoune posing on a bodybuilding competition stage" width="935" height="1482" fetchpriority="high" /><div class="photo-gradient"></div><span class="photo-index">MA / 01</span><span class="photo-vertical">THE WORK SPEAKS FOR ITSELF</span><div class="photo-caption"><span>MOHAMED AHIZOUNE</span><span>ATHLETE & PHYSIQUE</span></div></div>
          </div>
        </div>
        <div class="hero-bottom"><span>PERSONAL COACHING. A HIGHER STANDARD.</span><a href="#about">SCROLL TO DISCOVER <span aria-hidden="true">↓</span></a><span class="hero-bottom-index">01 / 07</span></div>
      </section>
      <div class="ticker" aria-hidden="true"><div><span>NO SHORTCUTS</span><i>·</i><span>JUST PURPOSE</span><i>·</i><span>SHOW UP. LEVEL UP.</span><i>·</i><span>NO SHORTCUTS</span><i>·</i><span>JUST PURPOSE</span><i>·</i><span>SHOW UP. LEVEL UP.</span><i>·</i></div></div>
      <section class="about section-shell" id="about">
        <div class="section-heading"><span class="eyebrow">01 / THE ATHLETE</span><span class="section-note">BEHIND THE PHYSIQUE</span></div>
        <div class="about-grid">
          <div class="about-photo podium-photo reveal"><img src="/images/mohamed-podium.webp" alt="Mohamed Ahizoune holding his medal alongside another competitor on the podium" width="595" height="807" loading="lazy" /><span class="photo-label">MEN’S PHYSIQUE COMPETITOR</span><span class="corner-mark" aria-hidden="true">+</span></div>
          <div class="about-copy reveal"><h2>A physique.<br />A mindset.<br /><em>A way of life.</em></h2><p class="intro">Meet Mohamed Ahizoune.</p><p>Six years of experience. A commitment that goes beyond what you see on stage. It lives in the training, the repetition, and the decision to keep showing up.</p><p>This is a space for that mindset. For building strength with intention, pursuing a better physique, and bringing more purpose to the process.</p><div class="experience"><strong>06<span>YEARS OF EXPERIENCE</span></strong><p>Built over time.<br />Brought to every session.</p></div><div class="signature">Mohamed Ahizoune<span>THE PERSON BEHIND THE PROGRESS</span></div><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">Follow the journey <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>
      <ProgramExplorer />
      <Skills />
      <Pricing />
      <section class="achievements-section section-shell" id="achievements" aria-labelledby="achievements-title">
        <div class="section-heading"><span class="eyebrow">04 / Achievements</span><span class="section-note achievement-origin"><SvgMark kind="morocco" />Men’s Physique competitor</span></div>
        <div class="achievement-grid">
          <div class="achievement-copy reveal"><h2 id="achievements-title">Achievements.<br /><em>Earned on stage.</em></h2><p>Six years of experience. Three podium finishes. Mohamed’s journey as a Men’s Physique competitor, in the results.</p>
            <div class="achievement-record"><strong>02<span>PLACE</span></strong><div><span>NPC Pro Qualifier Marrakech</span><p><SvgMark kind="medal" />2026 · Second place</p></div></div>
            <div class="achievement-record"><strong>03<span>PLACE</span></strong><div><span>Finals Moroccan Championship</span><p><SvgMark kind="medal" />2026 · Third place</p></div></div>
            <div class="achievement-record"><strong>03<span>PLACE</span></strong><div><span>The Réal Contest</span><p><SvgMark kind="medal" />2023 · Junior category · Third place</p></div></div>
            <p class="achievement-attribution">Results listed on Mohamed’s Instagram profile.</p><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">View his Instagram <span aria-hidden="true">↗</span></a>
          </div>
          <div class="achievement-photo-shell reveal"><figure class="achievement-photo"><img src="/images/mohamed-award.webp" alt="Mohamed Ahizoune receiving a medal and holding his competition certificate" width="598" height="798" loading="lazy" /><figcaption><span>Recognition on stage</span><a href={instagram} target="_blank" rel="noopener noreferrer">@_mohamed_ahizoune ↗</a></figcaption></figure></div>
        </div>
      </section>
      <section class="manifesto" id="approach">
        <div class="section-shell"><div class="section-heading"><span class="eyebrow">05 / THE APPROACH</span><span class="section-note">THE WORK BEFORE THE RESULT</span></div><div class="manifesto-title reveal"><h2>IT’S NOT A PHASE.<br />IT’S <span>A STANDARD.</span></h2></div><div class="principles"><article class="reveal"><span>01 / INTENTION</span><h3>Know your why.</h3><p>A clear goal gives the work direction. Start with what matters to you, then build around it.</p></article><article class="reveal"><span>02 / CONSISTENCY</span><h3>Own the everyday.</h3><p>Progress is built in the ordinary sessions. In the effort you repeat, even when no one is watching.</p></article><article class="reveal"><span>03 / PROGRESSION</span><h3>Keep moving forward.</h3><p>Learn from the process. Refine your approach. Give yourself room to become stronger over time.</p></article></div></div>
      </section>
      <section class="faq section-shell" id="faq"><div class="section-heading"><span class="eyebrow">06 / GOOD TO KNOW</span><span class="section-note">BEFORE YOUR FIRST MESSAGE</span></div><div class="faq-grid"><h2>A little clarity.<br /><em>A better start.</em></h2><div class="faq-list">{faqs.map(([question, answer], index) => <details><summary><span class="faq-number">0{index + 1}</span><span>{question}</span><span class="faq-plus" aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div></section>
      <ContactForm />
    </main>
    <footer class="site-footer"><a class="footer-name" href="#home">MOHAMED AHIZOUNE<span>.</span></a><div><span>© {new Date().getFullYear()} Mohamed Ahizoune</span><span>BUILT WITH PURPOSE.</span><a href="#home">BACK TO TOP <span aria-hidden="true">↑</span></a></div></footer>
    <FloatingEnquiry />
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const updateTheme = (theme: string) => {
        document.documentElement.dataset.theme = theme;
        const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
        themeToggle?.setAttribute('aria-label', label); themeToggle?.setAttribute('title', label);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#11120f' : '#f5f4ef');
      };
      updateTheme(document.documentElement.dataset.theme ?? 'dark');
      themeToggle?.addEventListener('click', () => { const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; updateTheme(theme); try { localStorage.setItem('ma-theme', theme); } catch {} });
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#navigation');
      const closeMenu = () => { menuButton?.setAttribute('aria-expanded', 'false'); menuButton?.setAttribute('aria-label', 'Open navigation'); navigation?.classList.remove('is-open'); };
      menuButton?.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') !== 'true'; menuButton.setAttribute('aria-expanded', String(open)); menuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation'); navigation?.classList.toggle('is-open', open); });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') closeMenu(); });
      window.matchMedia('(min-width: 761px)').addEventListener('change', closeMenu);
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: 0.08 });
        document.querySelectorAll('.reveal').forEach(element => { element.classList.add('will-reveal'); observer.observe(element); });
      }
    </script>
  </body>
</html>

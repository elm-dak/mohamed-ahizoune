---
const packs = ['Starter', 'Transformation', 'Elite'];
const comparisons = [
  { label: 'Monthly coaching', values: ['MAD 900', 'MAD 2,519.10', 'MAD 4,049.10'], price: true },
  { label: 'Training', values: ['2 tailored sessions per week', 'Full customized training program', 'One to one personal coaching'] },
  { label: 'Nutrition', values: ['Basic nutrition guidance', 'Meal plan and macro guidance', 'Advanced nutrition and supplementation plan'] },
  { label: 'Support', values: ['Weekly progress check in', 'Weekly coaching and form feedback', 'Unlimited check ins and message support'] },
];
---

<details class="pack-comparison">
  <summary>
    <span class="comparison-summary-copy">
      <svg class="comparison-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false"><path d="M5 8h22M5 16h22M5 24h22M11 5v22M21 5v22" stroke="currentColor" stroke-width="1.2" /><path d="M12 9h8v6h-8z" fill="currentColor" opacity=".16" /></svg>
      <span>Compare the coaching packs<small>A closer look at the support</small></span>
    </span>
    <svg class="comparison-toggle" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
  </summary>
  <div class="comparison-content">
    <table role="table">
      <caption class="comparison-sr">Monthly coaching pack comparison. Full pack details appear above.</caption>
      <thead role="rowgroup">
        <tr role="row"><th scope="col" role="columnheader">Your support</th>{packs.map(pack => <th scope="col" role="columnheader">{pack}</th>)}</tr>
      </thead>
      <tbody role="rowgroup">
        {comparisons.map(row => <tr role="row" class:list={{ 'comparison-price': row.price }}>
          <th scope="row" role="rowheader">{row.label}</th>
          {row.values.map((value, index) => <td role="cell"><span class="comparison-mobile-name" aria-hidden="true">{packs[index]}</span><span>{value}</span></td>)}
        </tr>)}
      </tbody>
    </table>
    <p class="comparison-note">Start with the support that suits you. We can discuss your goals before you choose.</p>
  </div>
</details>

<style>
  .pack-comparison{margin-top:25px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  summary{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 2px;cursor:pointer;list-style:none;color:var(--ink)}
  summary::-webkit-details-marker{display:none}
  summary:focus-visible{outline:2px solid var(--lime);outline-offset:5px;border-radius:5px}
  .comparison-summary-copy{display:flex;align-items:center;gap:15px;font-size:14px;font-weight:500}
  .comparison-summary-copy small{display:block;font-size:10px;font-weight:400;color:var(--muted);margin-top:7px}
  .comparison-mark{width:30px;height:30px;flex:0 0 30px;color:var(--lime)}
  .comparison-toggle{width:22px;height:22px;flex:0 0 22px;color:var(--muted);transition:transform .35s var(--ease),color .35s var(--ease)}
  summary:hover .comparison-toggle{color:var(--lime)}
  details[open] .comparison-toggle{transform:rotate(45deg);color:var(--lime)}
  .comparison-content{padding:4px 0 24px}
  table{width:100%;table-layout:fixed;border-collapse:collapse;text-align:left;font-size:12px;line-height:1.7}
  th,td{padding:20px 18px;vertical-align:top;overflow-wrap:anywhere}
  thead th{font-weight:500;font-size:13px;border-bottom:1px solid var(--line)}
  thead th:first-child{font-size:10px;color:var(--muted);font-weight:400}
  tbody th{font-weight:400;color:var(--muted);font-size:11px}
  tbody tr+tr{border-top:1px solid var(--line)}
  th:first-child{padding-left:2px;width:19%}
  td:nth-child(3),thead th:nth-child(3){background:color-mix(in srgb,var(--lime) 4%,transparent)}
  .comparison-price td{font-variant-numeric:tabular-nums;font-weight:500;color:var(--lime);font-size:14px}
  .comparison-note{font-size:11px;line-height:1.8;color:var(--muted);margin:22px 2px 0}
  .comparison-mobile-name{display:none}
  .comparison-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:760px){
    .comparison-summary-copy{font-size:13px;gap:12px}
    summary{padding:22px 2px;gap:15px}
    .comparison-summary-copy small{font-size:10px}
    .comparison-mark{width:27px;height:27px;flex-basis:27px}
    .comparison-content{padding-top:0}
    table,tbody{display:block}
    thead{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    tbody tr{display:block;padding:18px 0}
    tbody tr:first-child{border-top:1px solid var(--line)}
    tbody th:first-child{display:block;width:auto;padding:0 2px 12px;font-size:11px;color:var(--ink);font-weight:500}
    td{display:grid;grid-template-columns:minmax(95px,.8fr) minmax(0,1.2fr);gap:14px;padding:11px 10px;font-size:12px;line-height:1.65;border-radius:6px}
    .comparison-mobile-name{display:block;color:var(--muted);font-size:11px;font-weight:400}
    .comparison-price td{font-size:13px}
    .comparison-note{margin-top:6px}
  }
  @media(max-width:360px){.comparison-summary-copy{font-size:12px;gap:9px}.comparison-mark{width:25px;height:25px;flex-basis:25px}td{gap:10px;padding:10px 7px;grid-template-columns:95px minmax(0,1fr)}}
  @media(prefers-reduced-motion:reduce){.comparison-toggle{transition:none}}
</style>

  ['02', 'Physique development', 'Work toward a balanced physique through training, nutrition guidance, and consistent progress reviews.'],
  ['03', 'Nutrition & daily habits', 'Practical nutrition guidance and everyday routines that support your training goals.'],
  ['04', 'Technique & form feedback', 'Review movement quality, refine your execution, and get more purpose from each session.'],

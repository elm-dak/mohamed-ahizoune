---
interface Props { kind: string; class?: string }
const { kind, class: className = '' } = Astro.props;
---
<svg class:list={['svg-mark', className]} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    {kind === 'strength' && <><path d="M15 24h18M7 19v10m34-10v10"/><rect x="10" y="14" width="5" height="20" rx="2"/><rect x="33" y="14" width="5" height="20" rx="2"/><path d="M20 11h8m-4-4v8" class="mark-detail"/></>}
    {kind === 'physique' && <><path d="M17 8c0 6-3 7-8 10l3 8 6-4v17h12V22l6 4 3-8c-5-3-8-4-8-10M19 12c2 2 8 2 10 0M18 27c3 2 9 2 12 0M24 18v16"/><path d="m21 36 3 3 3-3" class="mark-detail"/></>}
    {kind === 'nutrition' && <><path d="M10 26c1 9 6 13 14 13s13-4 14-13H10Z"/><path d="M8 26h32M24 23V11m0 7c-7 1-11-3-11-8 7-1 11 2 11 8Zm0-4c6 0 10-3 10-8-6 0-10 3-10 8Z"/><path d="M18 43h12" class="mark-detail"/></>}
    {kind === 'technique' && <><circle cx="26" cy="10" r="4"/><path d="m23 17-6 9 10 5 6 10M23 17l8 7 9-2M17 26l-6 13m16-8-8 10M8 44h33"/><path d="M8 18h6m-3-3v6" class="mark-detail"/></>}
    {kind === 'competition' && <><path d="M15 9h18v9c0 8-4 12-9 12s-9-4-9-12V9ZM24 30v8m-8 3h16M15 13H8v5c0 5 4 8 9 8m16-13h7v5c0 5-4 8-9 8"/><path d="m24 14 1.5 3 3.5.5-2.5 2.5.5 3.5-3-1.5-3 1.5.5-3.5L18 17.5l3.5-.5 2.5-3Z" class="mark-detail"/></>}
    {kind === 'progress' && <><path d="M9 9v30h30M15 31l8-8 6 4 10-14"/><path d="M32 13h7v7"/><circle cx="23" cy="23" r="2.5" class="mark-detail"/></>}
    {kind === 'message' && <><path d="M11 9h26a4 4 0 0 1 4 4v17a4 4 0 0 1-4 4H22L12 41v-7h-1a4 4 0 0 1-4-4V13a4 4 0 0 1 4-4Z"/><path d="M15 18h18m-18 7h11" class="mark-detail"/></>}
    {kind === 'plan' && <><rect x="10" y="9" width="28" height="32" rx="4"/><path d="M18 6v6m12-6v6M10 18h28m-20 8h12m-12 7h6"/><path d="m29 32 2 2 4-5" class="mark-detail"/></>}
    {kind === 'goal' && <><circle cx="23" cy="25" r="15"/><circle cx="23" cy="25" r="8"/><path d="m23 25 16-16m-6 0h6v6"/><circle cx="23" cy="25" r="1.5" fill="currentColor" stroke="none"/></>}
    {kind === 'coach' && <><circle cx="18" cy="15" r="6"/><path d="M6 38v-3c0-7 5-11 12-11s12 4 12 11v3M32 10a6 6 0 0 1 0 11m4 5c5 2 7 6 6 12"/><path d="m13 33 3 3 7-7" class="mark-detail"/></>}
    {kind === 'recovery' && <><path d="M35 9C18 8 9 15 12 28c13 6 24-2 23-19ZM10 39l18-21"/><path d="m19 30 1-8m4 3 7-1" class="mark-detail"/></>}
    {kind === 'medal' && <><path d="m13 7 7 13m15-13-7 13M13 7h8l3 6 3-6h8"/><circle cx="24" cy="30" r="11"/><circle cx="24" cy="30" r="7" class="mark-detail"/><path d="m21 30 2 2 4-4"/></>}
    {kind === 'morocco' && <><path d="M8 42V6m1 3h31v23H9"/><path d="m24 14 4.1 12.5-10.7-7.7h13.2l-10.7 7.7L24 14Z" class="mark-detail"/></>}
    {kind === 'whatsapp' && <><path d="m8 39 3-9a16 16 0 1 1 7 8L8 39Z"/><path d="M18 15c-1 1-2 3-1 6 2 6 6 10 12 11 3 0 5-2 5-4l-6-3-2 3c-3-1-6-4-7-7l2-2-3-4Z"/></>}
    {kind === 'arrow' && <><path d="M12 36 36 12M16 12h20v20"/></>}
    {kind === 'check' && <><path d="m11 25 9 9 18-21"/></>}
  </g>
</svg>
